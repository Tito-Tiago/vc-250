# BC-250 lean kernel config fragment
# Merged over `make defconfig` via scripts/kconfig/merge_config.sh
# Objetivo: mínimo necessário para headless LLM com Vulkan/RADV

# === AMDGPU embutido (não módulo) ===
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_DCN=y
CONFIG_DRM_AMD_DC_HDCP=y
CONFIG_DRM_AMD_DC_SI=y
CONFIG_DRM_AMD_ACP=y
CONFIG_DRM_AMD_DC_DCN3_0=y
CONFIG_DRM_AMD_DC_DCN3_2=y
CONFIG_HSA_AMD=y
CONFIG_HSA_AMD_SVM=y
CONFIG_AMD_IOMMU=y
CONFIG_AMD_IOMMU_V2=y

# === Firmware amdgpu ===
CONFIG_EXTRA_FIRMWARE="amdgpu/cyan_skillfish_ce.bin amdgpu/cyan_skillfish_me.bin amdgpu/cyan_skillfish_mec.bin amdgpu/cyan_skillfish_pfp.bin amdgpu/cyan_skillfish_rlc.bin amdgpu/cyan_skillfish_sos.bin amdgpu/cyan_skillfish_ta.bin amdgpu/cyan_skillfish_asd.bin"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"

# === Desabilitar hardware desnecessário ===
# Áudio
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_SND_HDA_INTEL=n
CONFIG_SND_HDA_CODEC_REALTEK=n
CONFIG_SND_SOC=n
CONFIG_SND_PCI=n

# Bluetooth
CONFIG_BT=n
CONFIG_BT_BREDR=n
CONFIG_BT_LE=n

# Wi-Fi / Wireless
CONFIG_WLAN=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_WIRELESS=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_REALTEK=n

# DRM de outras GPUs
CONFIG_DRM_I915=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_VMWGFX=n
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_DRM_QXL=n
CONFIG_DRM_BOCHS=n
CONFIG_DRM_CIRRUS_QEMU=n
CONFIG_DRM_VBOXVIDEO=n
CONFIG_DRM_AST=n
CONFIG_DRM_MGAG200=n
CONFIG_DRM_RCAR_LVDS=n

# USB desnecessário
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=n
CONFIG_USB_OHCI_HCD=n
CONFIG_USB_UHCI_HCD=n
CONFIG_USB_DUMMY_HCD=n
CONFIG_USB_GADGET=n
CONFIG_USB_CONFIGFS=n

# Filesystems desnecessários
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_JFS_FS=n
CONFIG_REISERFS_FS=n
CONFIG_OCFS2_FS=n
CONFIG_GFS2_FS=n
CONFIG_CEPH_FS=n
CONFIG_AFS_FS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_SUNRPC=n
CONFIG_CIFS=n
CONFIG_9P_FS=n
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_ZSTD=y

# Manter: ext4, vfat, tmpfs, proc, sysfs
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# === Redes mínimas (headless LLM precisa SSH + HTTP) ===
CONFIG_INET=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_IPV6=y
CONFIG_NET_CLS_CGROUP=y

# Ethernet real (BC-250 tem NIC onboard)
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=n
CONFIG_8139TOO=n
CONFIG_R8169=y
CONFIG_E1000=n
CONFIG_E1000E=y
CONFIG_IGB=n
CONFIG_IXGBE=n

# === NVMe ===
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_NVME_CORE=y

# === Input mínimo ===
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_JOYDEV=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_HID_GENERIC=y
CONFIG_HID_BATTERY_STRENGTH=y

# === Térmico / sensores ===
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_SENSORS_NCT6683=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_HWMON=y

# === CPU freq (performance governor para LLM) ===
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

# === C-states / P-states ===
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_LADDER=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_INTEL_IDLE=n
CONFIG_AMD_IDLE=y

# === CGROUPs para resource control do llama-server ===
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=n
CONFIG_CGROUP_BPF=n
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y

# === Scheduler ===
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_PREEMPT_NONE=n
CONFIG_NO_HZ_FULL=n
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# === Otimizações para inferência ===
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=n
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_KSM=y
CONFIG_ZSWAP=n
CONFIG_ZRAM=n
CONFIG_HUGETLBFS=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y

# === Segurança mínima (headless) ===
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_SECURITY_YAMA=n
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=n
CONFIG_INIT_ON_FREE_DEFAULT_ON=n
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# === Debug mínimo (ativar temporariamente para troubleshooting) ===
CONFIG_DEBUG_FS=y
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_FUNCTION_TRACER=n
CONFIG_KGDB=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_FRAME_POINTER=n
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# === Power management ===
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_PM=y
CONFIG_PM_RUNTIME=y
CONFIG_CPU_FREQ_STAT=y

# === Crypto (para SSH) ===
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_POLY1305=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_CHACHA20POLY1305=y

# === PCI / PCIe ===
CONFIG_PCI=y
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_POWERSAVE=y
CONFIG_PCIEPORTBUS=y

# === Misc ===
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SIG=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=n
CONFIG_BUG=y
CONFIG_ELF_CORE=n
CONFIG_COREDUMP=n
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=4